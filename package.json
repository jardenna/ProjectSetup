{
  "name": "startup-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "stylelint": "npx stylelint \"**/*.scss\"",
    "stylelint:fix": "npx stylelint \"**/*.scss\" --fix",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "lint-staged": {
    "*.{ts, tsx, js}": [
      "eslint"
    ],
    "*.{scss, css}": [
      "stylelint"
    ],
    "*": [
      "prettier --write --ignore-unknown"
    ]
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-redux": "^9.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@eslint-react/eslint-plugin": "^5.30.1",
    "@eslint/js": "^10.0.1",
    "@reduxjs/toolkit": "^2.14.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-checker": "^0.14.5"
  }
}
